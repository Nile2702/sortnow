# Copy this file to .env.local and fill in real values for your environment.
# .env.local is gitignored - never commit real secrets.

INTERNAL_API_URL=http://localhost:3000/api
EDGE_CONFIG_URL=http://localhost:3000/api/internal/domain-map

# Signs and verifies seller session cookies (lib/auth/session.ts). Falls back
# to an insecure hardcoded value if unset, which is fine for local dev but
# MUST be set to a long random string before deploying - otherwise every
# seller session token is forgeable.
SESSION_SECRET=

# Enables the "Enhance with AI" product-photo feature (lib/ai-photo-enhance.ts):
# removes the background from a seller's raw photo and places the garment on
# a mannequin form. Get a key from https://aistudio.google.com/apikey - the
# feature fails gracefully with a clear error if this is left unset.
GEMINI_API_KEY=

# Optional: override the Gemini model used for photo enhancement.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Powers the interactive store map on /shops (components/StoreMap.tsx).
# Get a free token at https://account.mapbox.com/auth/signup/ - no billing
# info required. Public/client-side by design (NEXT_PUBLIC_), same as any
# Mapbox GL JS token. The map falls back to a plain list if unset.
NEXT_PUBLIC_MAPBOX_TOKEN=

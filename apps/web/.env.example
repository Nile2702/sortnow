# Copy this file to .env.local and fill in real values for your environment.
# .env.local is gitignored - never commit real secrets.

# The Postgres (Neon) connection string every piece of persistent data in
# this app reads and writes through (lib/db.ts). Required - nothing works
# without it, and createPool() throws a clear error if it's unset rather
# than failing with a cryptic connection error later.
DATABASE_URL=

EDGE_CONFIG_URL=http://localhost:3000/api/internal/domain-map

# Signs and verifies seller session cookies (lib/auth/session.ts). Falls back
# to an insecure hardcoded value if unset, which is fine for local dev but
# MUST be set to a long random string before deploying - otherwise every
# seller session token is forgeable.
SESSION_SECRET=

# Cloudinary account that product/store photos are uploaded to
# (app/api/v1/seller/upload/route.ts). Required for a seller to actually
# publish a photo - the upload route returns a clear "not configured" error
# if any of the three is missing rather than failing silently. Get these
# from your Cloudinary dashboard (cloudinary.com) under Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Enables the "Enhance with AI" product-photo feature (lib/ai-photo-enhance.ts):
# removes the background from a seller's raw photo and places the garment on
# a mannequin form. Get a key from https://aistudio.google.com/apikey - the
# feature fails gracefully with a clear error if this is left unset.
GEMINI_API_KEY=

# Optional: override the Gemini model used for photo enhancement.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: override the Gemini model used for the AI product-autofill
# feature (lib/ai-product-autofill.ts - suggests a title/description/
# category from a photo). Shares GEMINI_API_KEY above; defaults to a fast,
# cheap text+vision model if unset.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Powers the interactive store map on /shops (components/StoreMap.tsx).
# Get a free token at https://account.mapbox.com/auth/signup/ - no billing
# info required. Public/client-side by design (NEXT_PUBLIC_), same as any
# Mapbox GL JS token. The map falls back to a plain list if unset.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Shared secret that gates the pilot's manual seller-review tool
# (/admin/sellers and /api/v1/admin/**, see lib/admin-auth.ts) - there's no
# real admin login system, just this one shared password for the site
# owner. Visit /admin/sellers?key=<this value> to approve/reject newly
# signed-up sellers after they submit GSTIN/PAN/UPI during onboarding.
# Set this to a long random string before deploying - if unset, the admin
# tool rejects every request (fails closed, never defaults to open).
ADMIN_SECRET=

# AES-256-GCM key (lib/encryption.ts) encrypting a seller's GSTIN/PAN/UPI
# VPA and Gemini API key at rest - the handful of columns on `stores` that
# are genuinely confidential, not just application-gated. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must decode (base64) to exactly 32 bytes. Required to WRITE any of those
# fields (submitStoreForReview/updateStoreAccountDetails/
# updateStoreGeminiKey throw if unset) - reads of an already-encrypted value
# also need it, but a legacy plaintext value (from before this existed)
# reads back fine with no key at all, see decryptField's passthrough.
# Losing this key makes every value already encrypted with it permanently
# unrecoverable - keep it somewhere safe outside of just this file.
DATA_ENCRYPTION_KEY=

# Delivers OTP login codes by email (lib/email.ts, via Resend's REST API) -
# this pilot deliberately uses email instead of SMS to avoid India's
# SMS/DLT template-registration requirement. Optional: get a free key at
# https://resend.com/api-keys. If unset, OTP requests fall back to logging
# the code to the server console and echoing it back in the API response as
# devOtp (shown on-screen as "Dev mode" in the seller/shopper OTP login UI)
# - exactly today's behavior. The moment this is set, real email delivery
# turns on automatically and devOtp stops being returned - no other code
# changes needed.
RESEND_API_KEY=

# Optional: the "From" address OTP emails are sent as. Defaults to Resend's
# own sandbox sender (onboarding@resend.dev), which works immediately with
# just an API key - no domain verification needed. Override once this
# deployment has a verified sending domain in Resend.
# RESEND_FROM_EMAIL=SORT NOW <onboarding@resend.dev>

# Enables "Continue with Google" on the shopper /account login page
# (lib/google-auth.ts verifies the token server-side; the matching
# NEXT_PUBLIC_ below is what the client-side Google button uses to render).
# Both must be set to the SAME value - a Google OAuth 2.0 Client ID, not a
# secret, safe to expose client-side (see lib/google-auth.ts's own note on
# why). Get one free from https://console.cloud.google.com/apis/credentials:
# create an OAuth client ID of type "Web application", add this site's
# origin(s) (e.g. https://sortnow.in and http://localhost:3000) under
# "Authorized JavaScript origins", then copy the Client ID here. If either
# of these is unset, the whole Google sign-in section simply doesn't render
# - same graceful-degradation shape as every other optional integration in
# this file - rather than showing a broken button.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional override for the canonical base URL used in the sitemap, robots.txt,
# and OpenGraph/share-preview metadata (lib/site-url.ts). Without this,
# Vercel's own VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL are used automatically,
# which already keeps this correct across every deploy with zero config - only
# set this if you need to force a specific domain (e.g. testing a preview
# deploy's metadata as if it were the real production domain).
# NEXT_PUBLIC_SITE_URL=https://sortnow.in

# Dev-only convenience: set to "1" to let middleware.ts treat a LAN IP or a
# tunnel host (ngrok, localtunnel, Cloudflare Tunnel - see middleware.ts's own
# DEV_TUNNEL_HOST list) as the platform root, for previewing this app on a
# phone during local development. Deliberately defaults off and is never
# honored in a real production deploy regardless of this setting.
# ALLOW_LOCAL_TUNNEL_HOST=1
